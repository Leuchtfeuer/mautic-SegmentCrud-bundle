{
    "name": "leuchtfeuer/mautic-segmentcrud-bundle",
    "description": "Leuchtfeuer Segment CRUD plugin for Mautic",
    "license": "GPL-3.0-or-later",
    "type": "mautic-plugin",
    "homepage": "https://www.Leuchtfeuer.com",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Leuchtfeuer Digital Marketing GmbH",
            "email": "mautic-plugins@Leuchtfeuer.com",
            "homepage": "https://Leuchtfeuer.com/mautic/",
            "role": "Developer"
        }
    ],
    "keywords": [
        "mautic",
        "plugin",
        "segment",
        "leuchtfeuer"
    ],
    "extra": {
        "install-directory-name": "LeuchtfeuerSegmentCrudBundle"
    },
    "require": {
        "php": "^8.1",
        "mautic/core-lib": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.4",
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpstan/phpstan-strict-rules": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\LeuchtfeuerSegmentCrudBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\LeuchtfeuerSegmentCrudBundle\\Tests\\": "Tests"
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/mautic/FOSOAuthServerBundle.git"
        },
        {
            "type": "git",
            "url": "https://github.com/mautic/SpBundle.git"
        },
        {
            "type": "git",
            "url": "https://github.com/mautic/SymfonyBridgeBundle.git"
        }
    ],
    "scripts": {
        "fixcs": "./vendor/bin/php-cs-fixer fix --config .php-cs-fixer.php --show-progress dots -v",
        "phpstan": "./vendor/bin/phpstan",
        "phpunit": "./vendor/bin/phpunit -c phpunit.xml",
        "test": "@phpunit",
        "all": [
            "@fixcs",
            "@phpstan",
            "@phpunit"
        ]
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "php-http/discovery": false
        }
    }
}
