{
  "name": "leuchtfeuer/mautic-segmentcrud-bundle",
  "description": "Console command to create / modify / delete segments, or to clear their content",
  "license": "GPL-3.0",
  "type": "mautic-plugin",
  "homepage": "https://www.Leuchtfeuer.com",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Leuchtfeuer Digital Marketing GmbH",
      "email": "mautic-plugins@Leuchtfeuer.com",
      "homepage": "https://Leuchtfeuer.com/mautic/",
      "role": "Developer"
    }
  ],
  "keywords": [
    "mautic",
    "plugin",
    "integration",
    "segment",
    "leuchtfeuer"
  ],
  "extra": {
    "install-directory-name": "LeuchtfeuerSegmentCrudBundle"
  },
  "require": {
    "php": "^8.2",
    "mautic/core-lib": "^7.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.4",
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "MauticPlugin\\LeuchtfeuerSegmentCrudBundle\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MauticPlugin\\LeuchtfeuerSegmentCrudBundle\\Tests\\": "Tests"
    }
  },
  "scripts": {
    "fixcs": "../../bin/php-cs-fixer fix --config .php-cs-fixer.php --show-progress dots -v",
    "rector": "cd ../.. && bin/rector process --ansi --config rector.php plugins/LeuchtfeuerSegmentCrudBundle",
    "phpstan": "../../bin/phpstan analyse . --memory-limit=1G -c phpstan.neon",
    "phpunit": "../../bin/phpunit -d memory_limit=2048M --configuration phpunit.xml --fail-on-warning",
    "unit": "../../bin/phpunit -d memory_limit=2048M --configuration phpunit.xml --fail-on-warning --testsuite=unit",
    "functional": "cd ../.. && APP_ENV=test APP_DEBUG=0 KERNEL_CLASS=AppTestKernel bin/phpunit -d memory_limit=2G -c plugins/LeuchtfeuerSegmentCrudBundle/phpunit.xml --testsuite functional",
    "coverage": "../../bin/phpunit -d memory_limit=2048M --configuration phpunit.xml --fail-on-warning --coverage-text --coverage-html=Tests/Coverage",
    "test": "@phpunit",
    "dod": "bash checkDod.sh",
    "all": [
      "@rector",
      "@fixcs",
      "@phpstan",
      "@phpunit",
      "@dod"
    ]
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "php-http/discovery": false
    }
  }
}
